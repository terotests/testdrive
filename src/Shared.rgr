;
; helloworld -- the shared application module.
;
; ONE source, compiled to Kotlin for Android and to Swift for iOS. The host
; shell on each platform owns the lifecycle and the UI; this owns what the app
; KNOWS, and neither platform has its own copy of it.
;
; There is deliberately no `main`: the platform calls the shell, and the shell
; calls this.
;
; This file was written once and is yours now; nothing regenerates it.

class Shared {

    Constructor () {
    }

    fn greeting:string () {
        return "Hello World"
    }
}
